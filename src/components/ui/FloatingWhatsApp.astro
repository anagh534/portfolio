    class="flex items-center gap-3 px-4 py-3 rounded-full bg-black/90 backdrop-blur-xl border border-white/10 hover:border-emerald-500/50 shadow-2xl hover:shadow-emerald-500/20 transition-all duration-300 hover:-translate-y-1"
